  "classes": {
    "A": "Released skill bundles. Git owns executable skill behavior and the installable tagged package; a bundle is unchanged at the released commit and changes only at a new tagged, approved commit.",
    "B": "Content templates and their setup, configuration and diagram explanations. Notion-authored Draft edition; frozen ZIP exports; never written by the publisher.",
    "G": "Public guide pages: the readable human version of the repository. Notion-authored originals, authoritative for the method explanation, the Data & Context definition template, setup and configuration special cases and diagrams. Bound by page id and content revision, exported to Git deliberately and never written from Git.",
    "W": "Git working documentation, public natively in the repository. Its optional Notion projection is labelled unreleased and needs a working database only if the owner provisions one.",
    "C": "The owner's private documentation control and daily state. Not a CI source or credential scope; deliberately absent from this manifest."
  },
  "writers": {
    "existing-upkeep": "The existing private maintenance route; relinquishes these exact rows to CI at activation.",
    "ci": "The publisher in CI, using the dedicated connection limited to the public subtree.",
    "notion-authored": "Edited by hand in Notion; the publisher reads it to freeze a snapshot and never writes it."
  },
  "ci_inputs": [
    {
      "kind": "git-commit",
      "note": "Frozen source commit of this repository"
