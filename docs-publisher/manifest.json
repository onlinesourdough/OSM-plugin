    "guide": {
      "label": "2026-11-25.1",
      "state": "Notion-authored originals bound per page and package edition; read times and content revisions are recorded on each artifact.",
      "owner": "notion"
    },
    "content-templates": {
      "label": "2026-11-05.1",
      "packet": "0.10.0",
